# ===== Google OAuth =====
# Samakan dengan clientId di frontend (main.jsx / VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=154325619553-16skq2jomkno70n87nnkpptkgipakq9f.apps.googleusercontent.com

# ===== Database =====
# Kosongkan / hapus baris ini untuk pakai SQLite lokal (geosense.db)
#
# Supabase -> Project Settings -> Database -> Connection string
# Pakai "Session pooler" (port 5432) atau "Transaction pooler" (port 6543).
# Ganti [YOUR-PASSWORD] dengan password database kamu.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# (opsional) paksa SSL. Supabase wajib require.
PGSSLMODE=require

# ===== Auth / JWT =====
# WAJIB diganti di produksi. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=ganti-dengan-string-random-panjang
JWT_EXPIRE_HOURS=168

# Email yang otomatis jadi admin saat login Google (pisahkan dengan koma)
ADMIN_EMAILS=admin@contoh.com

# ===== CORS =====
# Pisahkan dengan koma. Contoh: http://localhost:5173,https://geosense.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ===== MQTT (HiveMQ Cloud) =====
MQTT_BROKER=3cd0f777a8ec4a20af722dd1214f7eb3.s1.eu.hivemq.cloud
MQTT_PORT=8883
# Pisahkan dengan koma kalau backend harus subscribe beberapa topik.
MQTT_TOPIC=rawdata,gpsdata
MQTT_USERNAME=geosense-process
MQTT_PASSWORD=ganti-password

# ===== WhatsApp (Fonnte) =====
# Token dari https://fonnte.com -> Device -> Token. Kosongkan = notifikasi WA mati.
WA_ENABLED=1
FONNTE_TOKEN=
WA_NOTIFY_STATUSES=SIAGA,WASPADA,WARNING,BAHAYA
WA_COOLDOWN_SECONDS=300
APP_URL=http://localhost:5173

# ===== Web Push / PWA (notifikasi browser) =====
# Kosongkan PUSH_ENABLED / VAPID_PUBLIC_KEY untuk mematikan fitur ini.
# Kunci privat disimpan di file terpisah dan JANGAN di-commit.
PUSH_ENABLED=0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PATH=vapid_private.pem
VAPID_SUBJECT=mailto:admin@contoh.com
PUSH_NOTIFY_STATUSES=SIAGA,WASPADA,WARNING,BAHAYA
PUSH_COOLDOWN_SECONDS=300

# ===== Lain-lain =====
SQL_ECHO=0
